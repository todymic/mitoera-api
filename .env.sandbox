APP_ENV=sandbox
APP_SECRET=CHANGE_ME_SANDBOX_SECRET

POSTGRES_DB=mitoera_sandbox
POSTGRES_USER=tody
POSTGRES_PASSWORD=CHANGE_ME_SANDBOX_DB_PASS

DATABASE_URL="postgresql://tody:CHANGE_ME_SANDBOX_DB_PASS@postgres-sandbox:5432/mitoera_sandbox?serverVersion=16&charset=utf8"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE

MERCURE_URL=http://mercure:3010/.well-known/mercure
MERCURE_PUBLIC_URL=https://api.mitoera.com/.well-known/mercure
MERCURE_JWT_SECRET=CHANGE_ME_MERCURE_SECRET

DEFAULT_URI=https://api.mitoera.com
APP_SHARE_DIR=var/share
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
REDIS_URL=redis://redis:6379
SEATING_HOLD_DURATION_MINUTES=10
SEATING_SESSION_DURATION_MINUTES=60
CORS_ALLOW_ORIGINS='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://admin\.mitoera\.com$'

FIREBASE_CREDENTIALS_PATH=/app/config/mitoera-firebas-credentials.json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
