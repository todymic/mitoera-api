{% extends 'emails/layout.html.twig' %}

{% block title %}[Mitoera] {{ subjectLabel }} — {{ senderName }}{% endblock %}

{% block content %}
  <h1 style="margin:0 0 8px;font-size:20px;font-weight:700;color:#111827;">
    {{ subjectLabel }}
  </h1>
  <p style="margin:0 0 24px;font-size:14px;color:#6b7280;">
    Message reçu de <strong style="color:#111827;">{{ senderName }}</strong>
    (<a href="mailto:{{ senderEmail }}" style="color:#4f46e5;">{{ senderEmail }}</a>)
  </p>

  <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:20px;font-size:15px;color:#374151;white-space:pre-wrap;line-height:1.6;">{{ messageBody }}</div>
{% endblock %}
